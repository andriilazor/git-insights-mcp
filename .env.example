# Repositories the server may read, as comma-separated alias=path pairs.
# Tools take the alias; paths never leave the server.
GIT_INSIGHTS_REPOS=app=/path/to/repo

# Required for --transport streamable-http: clients send "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GIT_INSIGHTS_TOKEN=

# Host header values accepted over HTTP (DNS-rebinding protection). Needed when the
# server binds to anything other than localhost, e.g. inside Docker.
GIT_INSIGHTS_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000

# Authorization server advertised to HTTP clients. A stand-in: this server only checks
# the static token above and never issues tokens.
# GIT_INSIGHTS_ISSUER_URL=http://localhost

# Limits for a single git call.
# GIT_INSIGHTS_GIT_TIMEOUT=10
# GIT_INSIGHTS_MAX_OUTPUT_BYTES=5000000

# docker compose only: the repository to mount read-only at /repos/app.
REPO_PATH=.
